{
  "name": "kangaroo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "test:ct": "playwright test -c playwright-ct.config.ts",
    "test:ct:coverage": "rm -rf coverage && COVERAGE=1 npm run test:ct && node playwright/coverage-report.mjs",
    "test:ct:coverage:report": "xdg-open coverage/report/index.html",
    "preview": "vite preview",
    "start": "npm run dev"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@dnd-kit/react": "0.5.3",
    "@fullcalendar/react": "^7.1.4",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.46",
    "@uiw/react-codemirror": "4.25.12",
    "apexcharts": "^8.4.1",
    "react": "19.2.8",
    "react-cookie-consent": "10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "7.90.0",
    "tailwindcss": "4.3.5",
    "temporal-polyfill": "^1.0.8"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.62.1",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.3.0",
    "monocart-coverage-reports": "2.13.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.81.0",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
